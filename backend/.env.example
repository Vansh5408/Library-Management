# Library Management System - Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Secret Key (CRITICAL - CHANGE THIS IN PRODUCTION!)
# Generate a secure random key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters recommended for production
JWT_SECRET=your-secret-key-change-this-in-production-use-minimum-32-chars

# JWT Configuration
JWT_EXPIRES_IN=7d
JWT_ISSUER=library-management-system
JWT_AUDIENCE=library-app-users

# Production Security Settings
# Uncomment and configure for production deployment:
# NODE_ENV=production
# JWT_SECRET=<your-production-secret-here>
# FRONTEND_URL=https://your-frontend-domain.com
# PORT=5000

# Database Configuration
# (Currently using JSON file storage - paths are automatically configured)

# Optional: Logging
LOG_LEVEL=info

# Optional: Rate Limiting (not yet implemented)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# External Book APIs
# Google Books API Key (optional - get from https://console.cloud.google.com/)
# Without an API key, you're limited to 1000 requests per day
# With an API key, you get 10,000 requests per day for free
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# ==================== AI CONFIGURATION ====================
# AI Model Configuration for Advanced Features
# Choose: 'local' (default, no API key needed) | 'openai' | 'anthropic'
AI_MODEL=local

# OpenAI API Key (optional - for enhanced AI features)
# Get from: https://platform.openai.com/api-keys
# Required only if AI_MODEL=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional - for Claude AI features)
# Get from: https://console.anthropic.com/
# Required only if AI_MODEL=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Enable/Disable AI Features (true/false)
# All features work with local AI (no API keys needed)
AI_ENABLE_RECOMMENDATIONS=true
AI_ENABLE_SMART_SEARCH=true
AI_ENABLE_CHATBOT=true
AI_ENABLE_SUMMARIES=true
AI_ENABLE_ANALYTICS=true

# Notes:
# 1. Never commit the .env file to version control
# 2. Use strong, unique JWT_SECRET in production (minimum 32 characters)
# 3. Update FRONTEND_URL to match your deployed frontend
# 4. Consider using environment-specific .env files (.env.production, .env.development)
# 5. Google Books API key is optional but recommended for production use
# 6. AI features work locally without API keys but can use OpenAI/Anthropic for enhanced capabilities
